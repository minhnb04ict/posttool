PORT=3000
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyDUDJO4T3KKsigwpcG6XrlHo4hs9kZ7sYvAn2R1y6WClQjy_rqA8YWvF9EjQmRjiWg/exec
# Local only. Trên Vercel Posttool tự dùng @sparticuz/chromium.
CHROME_EXECUTABLE_PATH=
# Giữ request report dưới ngưỡng serverless. Ảnh lớn được nén ở trình duyệt.
MAX_IMAGE_UPLOAD_MB=3
REPORT_JSON_LIMIT=4mb
GAS_TIMEOUT_MS=45000
GAS_RETRIES=2

# client-first nhanh hơn; server-first chỉ dùng khi muốn ép Puppeteer làm chính.
REPORT_STRATEGY=client-first

# Tối ưu khi nhiều máy học sinh mở trang đồng thời.
TASK_CACHE_TTL_MS=2000
TASK_STALE_MS=300000
TASK_UPSTREAM_TIMEOUT_MS=10000
TASK_UPSTREAM_RETRIES=2
STARTUP_JITTER_MS=350
